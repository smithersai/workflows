{
  "name": "xiv",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "xiv": "./src/cli.ts"
  },
  "files": [
    "src",
    "pack",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
