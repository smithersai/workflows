    "@effect/platform": "0.96.1",
    "@effect/platform-bun": "0.90.0",
    "@types/mdx": "2.0.14",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "effect": "3.21.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "smithers-orchestrator": "0.22.0",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "bun-types": "1.3.5"
  }
