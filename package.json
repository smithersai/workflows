    "check:types": "! rg -n \"\\bany\\b|@ts-(ignore|expect-error)\" src pack test --glob '!pack/prompts/**' --glob '!pack/node_modules/**'",
    "verify": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
